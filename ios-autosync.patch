index d390a95..713307a 100644
--- a/iosApp/iosApp/Player/FFmpegSeekPreviewGenerator.swift
+++ b/iosApp/iosApp/Player/FFmpegSeekPreviewGenerator.swift
@@ -370,3 +370,221 @@ final class FFmpegSeekPreviewGeneratorCreator: NSObject, NuvioSeekPreviewGenerat
